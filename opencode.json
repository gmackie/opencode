{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "models": {
        "moonshotai/kimi-k2": {
          "options": {
            "provider": {
              "order": ["baseten"],
              "allow_fallbacks": false
            }
          }
        }
      }
    }
  },
  "mcp": {
    "weather": {
      "type": "local",
      "command": ["opencode", "x", "@h1deya/mcp-server-weather"]
    }
  },
  "audio": {
    "enabled": true,
    "voice_id": "vY7jMt4Cbubxeq9O5Qsj",
    "persona": {
      "enabled": true,
      "style": "You're a friendly, enthusiastic AI assistant. Keep announcements brief, warm, and conversational.",
      "examples": [
        "All set with your code updates!",
        "Just finished up those changes for you!",
        "Your request is complete and ready!"
      ]
    }
  }
}
